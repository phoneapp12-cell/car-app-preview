{
  // Due Dates calendar link relay (Cloudflare Workers, free plan).
  "name": "due-dates-calendar-relay",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  // 2.22.38: Workers AI (free daily allowance) writes the Notifications summary. Nothing is stored.
  "ai": { "binding": "AI" },
  // No request logs, traces or analytics are kept for this Worker.
  "observability": { "enabled": false, "logs": { "enabled": false, "invocation_logs": false } },
  "vars": {
    "ALLOWED_ORIGIN": "https://phoneapp12-cell.github.io",
    // Public half of the push (VAPID) key. The private half is the Worker secret VAPID_PRIVATE_JWK.
    "VAPID_PUBLIC": "BEsNn0TcOiNQqSE7AbDFgYGL_v45EEm-mma2_6DtecoG5c7ZvwZ7lKpAXOQry7cqfvWM0JTjtPPdK93arc0VXMU"
  },
  // Holds the public Whangārei events list, bridge closure notices, a 20-minute copy of the weather,
  // and the push subscriptions for bridge alerts (push address and its keys only).
  "kv_namespaces": [
    { "binding": "EVENTS_KV", "id": "471149f31c3f46bda746283ffba8b4d3" }
  ],
  // Every 10 minutes: refresh the events list (every 3 hours) or read a few event pages for times.
  // Minutes 5, 15, 25…: the same for the council's closure notices about the lifting bridge.
  // Every minute: send a reminder whose Auckland time has arrived (evenings and weekends included).
  "triggers": { "crons": ["*/10 * * * *", "5-59/10 * * * *", "* * * * *"] }
}
