{
  // Due Dates calendar link relay (Cloudflare Workers, free plan).
  "name": "due-dates-calendar-relay",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  // No request logs, traces or analytics are kept for this Worker.
  "observability": { "enabled": false, "logs": { "enabled": false, "invocation_logs": false } },
  "vars": {
    "ALLOWED_ORIGIN": "https://phoneapp12-cell.github.io"
  },
  // Holds the public Whangārei events list, bridge closure notices and a 20-minute copy of the weather. Nothing personal.
  "kv_namespaces": [
    { "binding": "EVENTS_KV", "id": "471149f31c3f46bda746283ffba8b4d3" }
  ],
  // Every 10 minutes: refresh the events list (every 3 hours) or read a few event pages for times.
  // Minutes 5, 15, 25…: the same for the council's closure notices about the lifting bridge.
  "triggers": { "crons": ["*/10 * * * *", "5-59/10 * * * *"] }
}
