{
  // My Feed refresher: Shane's private photo and video feed (Cloudflare Workers, free plan).
  "name": "shane-my-feed-data",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "observability": { "enabled": false },
  "kv_namespaces": [{ "binding": "FEED_KV", "id": "9e0643489b0f4879bf6c75939d9b6c92" },
    // 1.9.0 read-only: My App's own copies of the shared cars' due dates (Sarah's PNU312, Cass's KBZ234) in its data service
    { "binding": "RELAY_KV", "id": "471149f31c3f46bda746283ffba8b4d3" }],
  // Every 10 minutes: refresh the 6 most out-of-date sources (at most 2 YouTube, 1 scraped site). Each source comes round about every 2.7 hours.
  // Picture subjects are not chosen on this tick. subjects.js runs at most once per NZ day, inside the 4am hour, and makes at most one short Workers AI call.
  // 1.7.0: the family network (members, comments, settings) lives in one SQLite Durable Object (free plan)
  "durable_objects": { "bindings": [{ "name": "FAMILY", "class_name": "Family" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Family"] }],
  // 1.9.12 🤖 Info Bot: Workers AI (free daily allocation)
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["*/10 * * * *"] }
}
